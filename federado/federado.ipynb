cc: 0.9023\n","      [center_4] época 04/20 — train_loss: 0.0194 acc: 0.9932 | val_loss: 0.3668 acc: 0.8945\n","      [center_4] época 05/20 — train_loss: 0.0117 acc: 0.9961 | val_loss: 0.4363 acc: 0.8945\n","      [center_4] época 06/20 — train_loss: 0.0173 acc: 0.9932 | val_loss: 0.3635 acc: 0.8828\n","      [center_4] época 07/20 — train_loss: 0.0198 acc: 0.9932 | val_loss: 0.3976 acc: 0.8945\n","      [center_4] época 08/20 — train_loss: 0.0139 acc: 0.9951 | val_loss: 0.5023 acc: 0.9023\n","      [center_4] época 09/20 — train_loss: 0.0080 acc: 0.9961 | val_loss: 0.4095 acc: 0.8945\n","      [center_4] época 10/20 — train_loss: 0.0272 acc: 0.9932 | val_loss: 0.3301 acc: 0.9062\n","      [center_4] época 11/20 — train_loss: 0.0154 acc: 0.9941 | val_loss: 0.3209 acc: 0.9023\n","      [center_4] época 12/20 — train_loss: 0.0020 acc: 1.0000 | val_loss: 0.3364 acc: 0.9102\n","      [center_4] época 13/20 — train_loss: 0.0036 acc: 0.9980 | val_loss: 0.3146 acc: 0.9219\n","      [center_4] época 14/20 — train_loss: 0.0071 acc: 0.9971 | val_loss: 0.3302 acc: 0.9141\n","      [center_4] época 15/20 — train_loss: 0.0019 acc: 1.0000 | val_loss: 0.2717 acc: 0.9258\n","      [center_4] época 16/20 — train_loss: 0.0005 acc: 1.0000 | val_loss: 0.2982 acc: 0.9258\n","      [center_4] época 17/20 — train_loss: 0.0003 acc: 1.0000 | val_loss: 0.2816 acc: 0.9297\n","      [center_4] época 18/20 — train_loss: 0.0003 acc: 1.0000 | val_loss: 0.2863 acc: 0.9336\n","      [center_4] época 19/20 — train_loss: 0.0002 acc: 1.0000 | val_loss: 0.3046 acc: 0.9297\n","      [center_4] época 20/20 — train_loss: 0.0002 acc: 1.0000 | val_loss: 0.2887 acc: 0.9375\n","\n","  ───────────────────────────────────────────────────────\n","  Ronda 11 (q-FedAvg) — val_loss global: 0.0379\n","  Sin mejora 10/10\n","\n","  Early stopping en ronda 11\n","\n","============================================================\n","Entrenamiento federado q-FedAvg finalizado\n","Mejor val_loss global: 0.0337\n","Modelo guardado en   : pesos/modelo_global_qfedavg_mejor.pth\n"]}],"source":["\n","# Variables para seguimiento de la mejor ronda global\n","mejor_val_global   = float(\"inf\")\n","rondas_sin_mejora  = 0\n","total_muestras     = sum(d[\"n_train\"] for d in datos_centros.values())\n","\n","historial = {\"ronda\": [], \"val_loss\": []}\n","\n","# --- q-FedAvg specific parameter ---\n","Q_FEDAVG_POWER = 1.0 # Este parámetro controla la influencia de la pérdida local en la ponderación.\n","\n","# Entrenamiento federado con q-FedAvg\n","for ronda in range(1, RONDAS + 1):\n","\n","    print(f\"\\n{'='*60}\")\n","    print(f\"  RONDA {ronda}/{RONDAS} (q-FedAvg)\")\n","    print(f\"{'='*60}\")\n","\n","    pesos_centros    = []\n","    val_losses       = []\n","    val_accs         = []\n","    muestras_centros = []\n","    # Lista para almacenar los pesos efectivos de q-FedAvg\n","    qfedavg_effective_weights = []\n","\n","    # Entrenamiento local por centro\n","    for nombre, datos in datos_centros.items():\n","        print(f\"\\n  Centro: {nombre}\")\n","        pesos, val_loss, val_acc = entrenar_centro(\n","            nombre,\n","            modelo_global,\n","            datos[\"loader_train\"],\n","            datos[\"loader_val\"],\n","            EPOCHS_LOCAL\n","        )\n","        pesos_centros.append(pesos)\n","        val_losses.append(val_loss)\n","        val_accs.append(val_acc)\n","        muestras_centros.append(datos[\"n_train\"])\n","\n","        # Calcular el peso efectivo para q-FedAvg para este cliente\n","        epsilon = 1e-6\n","        effective_weight_for_client = datos[\"n_train\"] / ((val_loss + epsilon) ** Q_FEDAVG_POWER)\n","        qfedavg_effective_weights.append(effective_weight_for_client)\n","\n","\n","    # Agregación q-FedAvg: usar los pesos efectivos calculados\n","    pesos_globales = agregar_pesos(pesos_centros, qfedavg_effective_weights)\n","    modelo_global.load_state_dict(pesos_globales)\n","\n","    val_global = sum(\n","        (1 - va) * (n / total_muestras)\n","        for va, n in zip(val_accs, muestras_centros)\n","    )\n","\n","    historial[\"ronda\"].append(ronda)\n","    historial[\"val_loss\"].append(val_global)\n","\n","    print(f\"\\n  {'─'*55}\")\n","    print(f\"  Ronda {ronda} (q-FedAvg) — val_loss global: {val_global:.4f}\")\n","\n","\n","    # Guardar el mejor modelo global\n","    if val_global < mejor_val_global:\n","\n","        mejor_val_global  = val_global\n","        rondas_sin_mejora = 0\n","        torch.save(modelo_global.state_dict(), MEJOR_MODELO_PATH_QFEDAVG)\n","        print(f\"  Mejor modelo global q-FedAvg guardado (val_loss: {mejor_val_global:.4f})\")\n","\n","    else:\n","\n","        rondas_sin_mejora += 1\n","        print(f\"  Sin mejora {rondas_sin_mejora}/{PACIENCIA}\")\n","\n","    # Early stopping\n","    if rondas_sin_mejora >= PACIENCIA:\n","        print(f\"\\n  Early stopping en ronda {ronda}\")\n","        break\n","\n","\n","print(f\"\\n{'='*60}\")\n","print(f\"Entrenamiento federado q-FedAvg finalizado\")\n","print(f\"Mejor val_loss global: {mejor_val_global:.4f}\")\n","print(f\"Modelo guardado en   : {MEJOR_MODELO_PATH_QFEDAVG}\")\n"]},{"cell_type":"code","source":["MEJOR_MODELO_PATH_QFEDAVG= PESOS_DIR / \"modelo_global_qfedavg_mejor.pth\""],"metadata":{"id":"UxaDfLoAKunY"},"id":"UxaDfLoAKunY","execution_count":null,"outputs":[]},{"cell_type":"markdown","id":"ZB3rzcs4Ioxn","metadata":{"id":"ZB3rzcs4Ioxn"},"source":["# Evaluacion"]},{"cell_type":"code","execution_count":13,"id":"rV_A1UplHsgZ","metadata":{"id":"rV_A1UplHsgZ","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1778555848312,"user_tz":300,"elapsed":380384,"user":{"displayName":"Jorge Fuquene","userId":"08044483799689057188"}},"outputId":"fb0e84da-7963-48d0-b58a-905115e80ffd"},"outputs":[{"output_type":"stream","name":"stdout","text":["\n","=================================================================\n","  EVALUACIÓN FINAL — TEST SET POR CENTRO\n","=================================================================\n","Métrica              Center 1   Center 2   Center 3   Center 4\n","─────────────────────────────────────────────────────────────────\n","  AUC-ROC              0.8807     0.2886     0.1235     0.2571\n","  Accuracy             0.8171     0.4708     0.3918     0.4469\n","  F1-Score             0.8050     0.6382     0.5630     0.6177\n","  Sensibilidad         0.7553     0.8000     0.6262     0.8266\n","  Especificidad        0.8789     0.0100     0.0000     0.0000\n","  Precisión            0.8619     0.5308     0.5115     0.4931\n","=================================================================\n"]}],"source":["# Cargar el mejor modelo global para evaluación final\n","modelo_global.load_state_dict(torch.load(MEJOR_MODELO_PATH_QFEDAVG , map_location=DEVICE))\n","modelo_global.eval()\n","\n","# Evaluación final en cada centro\n","def evaluar_centro(nombre, modelo, loader_test):\n","    todos_labels = []\n","    todos_probs  = []\n","    todos_preds  = []\n","\n","    with torch.no_grad():\n","        for imagenes, labels in loader_test:\n","            imagenes = imagenes.to(DEVICE)\n","            salida   = modelo(imagenes)\n","            probs    = torch.sigmoid(salida).squeeze(1).cpu().numpy()\n","            preds    = (probs >= 0.5).astype(int)\n","\n","            todos_labels.extend(labels.numpy().astype(int))\n","            todos_probs.extend(probs)\n","            todos_preds.extend(preds)\n","\n","    auc          = roc_auc_score(todos_labels, todos_probs)\n","    f1           = f1_score(todos_labels, todos_preds)\n","    sensibilidad  = recall_score(todos_labels, todos_preds)\n","    especificidad = recall_score(todos_labels, todos_preds, pos_label=0)\n","    precision    = precision_score(todos_labels, todos_preds)\n","    accuracy     = sum(p == l for p, l in zip(todos_preds, todos_labels)) / len(todos_labels)\n","    cm           = confusion_matrix(todos_labels, todos_preds)\n","\n","    return {\n","        \"auc\"         : auc,\n","        \"f1\"          : f1,\n","        \"sensibilidad\": sensibilidad,\n","        \"especificidad\": especificidad,\n","        \"precision\"   : precision,\n","        \"accuracy\"    : accuracy,\n","        \"cm\"          : cm,\n","        \"labels\"      : todos_labels,\n","        \"preds\"       : todos_preds,\n","    }\n","\n","\n","# Evaluar en cada centro\n","resultados = {}\n","\n","for nombre, datos in datos_centros.items():\n","    resultados[nombre] = evaluar_centro(nombre, modelo_global, datos[\"loader_test\"])\n","\n","# Metricas por centro\n","print(f\"\\n{'='*65}\")\n","print(f\"  EVALUACIÓN FINAL — TEST SET POR CENTRO\")\n","print(f\"{'='*65}\")\n","print(f\"{'Métrica':<18} {'Center 1':>10} {'Center 2':>10} {'Center 3':>10} {'Center 4':>10}\")\n","print(f\"{'─'*65}\")\n","\n","metricas = [\"auc\", \"accuracy\", \"f1\", \"sensibilidad\", \"especificidad\", \"precision\"]\n","nombres  = [\"AUC-ROC\", \"Accuracy\", \"F1-Score\", \"Sensibilidad\", \"Especificidad\", \"Precisión\"]\n","\n","for metrica, nombre_m in zip(metricas, nombres):\n","    vals = [resultados[c][metrica] for c in datos_centros]\n","    print(f\"  {nombre_m:<16} {vals[0]:>10.4f} {vals[1]:>10.4f} {vals[2]:>10.4f} {vals[3]:>10.4f}\")\n","\n","print(f\"{'='*65}\")"]},{"cell_type":"code","execution_count":17,"id":"00VSvucXIdA2","metadata":{"id":"00VSvucXIdA2","colab":{"base_uri":"https://localhost:8080/","height":197},"executionInfo":{"status":"ok","timestamp":1778555935692,"user_tz":300,"elapsed":909,"user":{"displayName":"Jorge Fuquene","userId":"08044483799689057188"}},"outputId":"7a67657c-4b9f-43aa-c63e-2c67e0a4dfee"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 2400x600 with 8 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["# Matriz de confusión por centro\n","fig, axes = plt.subplots(1, 4, figsize=(24, 6))\n","\n","for ax, (nombre, res) in zip(axes, resultados.items()):\n","    cm = res[\"cm\"]\n","\n","    sns.heatmap(cm, annot=False, fmt=\"d\", cmap=\"Blues\",\n","                xticklabels=[\"CONTROL\", \"STROKE\"],\n","                yticklabels=[\"CONTROL\", \"STROKE\"],\n","                linewidths=1.5, linecolor=\"white\", ax=ax)\n","\n","    for i in range(2):\n","        for j in range(2):\n","            color = \"white\" if cm[i, j] > cm.max() / 2 else \"black\"\n","            ax.text(j + 0.5, i + 0.5, str(cm[i, j]),\n","                    ha=\"center\", va=\"center\",\n","                    fontsize=20, fontweight=\"bold\", color=color)\n","\n","    etiquetas = [[\"TN\", \"FP\"], [\"FN\", \"TP\"]]\n","    for i in range(2):\n","        for j in range(2):\n","            ax.text(j + 0.5, i + 0.75, etiquetas[i][j],\n","                    ha=\"center\", va=\"center\",\n","                    fontsize=10, color=\"gray\")\n","\n","    n_test   = len(res[\"labels\"])\n","    accuracy = res[\"accuracy\"]\n","    ax.set_title(f\"{nombre}\\nAUC: {res['auc']:.4f} | Acc: {accuracy:.4f} | n={n_test}\",\n","                 fontsize=12, pad=12)\n","    ax.set_xlabel(\"Predicción\", fontsize=11)\n","    ax.set_ylabel(\"Real\", fontsize=11)\n","\n","plt.suptitle(\"Matrices de Confusión — Modelo q-FedAvg\", fontsize=14, y=1.02)\n","plt.tight_layout()\n","plt.show()"]}],"metadata":{"accelerator":"GPU","colab":{"gpuType":"A100","provenance":[]},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":5}
