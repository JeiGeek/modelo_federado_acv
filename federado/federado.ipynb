    "def seed_worker(worker_id):\n",
    "    worker_seed = torch.initial_seed() % 2**32\n",
    "    np.random.seed(worker_seed)\n",
    "    random.seed(worker_seed)\n",
    "\n",
    "# Definir esto una vez fuera de cargar_centro\n",
    "g = torch.Generator()\n",
    "g.manual_seed(SEED)"
   ]
